# Runtime
DOCKIT_ENV=local
# Existing DOCKIT_DATABASE_PATH remains a source-database alias for compatibility.
DOCKIT_DATABASE_PATH=data/dockit.db
DOCKIT_SOURCE_DATABASE_PATH=data/dockit.db
# When true, holds, audit, idempotency, and confirmed appointments share the
# authoritative database transaction.
DOCKIT_UNIFIED_AUTHORITATIVE_DATABASE=true
DOCKIT_STATE_DATABASE_PATH=data/dockit_state.db
DOCKIT_LOG_LEVEL=INFO
DOCKIT_LOG_JSON=true
DOCKIT_REQUEST_TIMEOUT_SECONDS=30
DOCKIT_REQUEST_BODY_MAX_BYTES=1048576
DOCKIT_REQUEST_RATE_LIMIT_PER_MINUTE=60
DOCKIT_SERVER_HOST=127.0.0.1
DOCKIT_SERVER_PORT=8000

# Redis / Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DOCKIT_CONVERSATION_TTL_SECONDS=1200

# OpenRouter (retrieve at runtime from Secrets Manager in AgentCore)
OPENROUTER_API_KEY=
DOCKIT_OPENROUTER_MODEL=openai/gpt-4o

# Amazon Cognito
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Amazon Bedrock AgentCore
AWS_REGION=
AGENTCORE_RUNTIME_ARN=
